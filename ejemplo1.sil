\begin[class=book, papersize=a4]{document}

\language[main=es]
\font[family=Liberation Serif, size=12pt]
\set[parameter=document.baselineskip, value=16pt]

% Cargamos el paquete para dibujar lineas finas
\use[module=packages.rules]

% --- CONFIGURACION DE MARGENES (1 CM) + ENCABEZADO + PIE ---
\begin{script}
  local frames = {
    -- Encabezado superior
    runningHead = {
      left = "1cm",
      right = "100%pw - 1cm",
      top = "0.7cm",
      bottom = "1.45cm"
    },
    -- Area principal del texto (incluye espacio automAtico para notas al pie)
    content = {
      left = "1cm",
      right = "100%pw - 1cm",
      top = "1.6cm",
      bottom = "100%ph - 1.5cm"
    },
    -- Pie de pagina para el numero de folio
    folio = {
      left = "1cm",
      right = "100%pw - 1cm",
      top = "100%ph - 1.4cm",
      bottom = "100%ph - 0.8cm"
    }
  }
  SILE.documentState.thisPageTemplate.frames = frames
  SILE.typesetter:initFrame(SILE.getFrame("content"))

  -- --- NUMERACION DE PAGINA ALTERNA (PARES IZQ / IMPARES DER) ---
  SILE.registerCommand("output-folio", function (_, _)
    local folio = SILE.formatCounter(SILE.scratch.counters.folio)
    local isOdd = SILE.documentState.documentClass:oddPage()
    
    SILE.typesetNaturally(SILE.getFrame("folio"), function ()
      SILE.settings:toplevelState()
      SILE.call("font", { size = "10pt" }, function ()
        if isOdd then
          SILE.call("raggedleft", {}, { folio })
        else
          SILE.call("raggedright", {}, { folio })
        end
      end)
    end)
  end)
\end{script}

% --- ENCABEZADOS ALTERNOS CON LiNEA HORIZONTAL ---
\define[command=even-running-header]{%
  \begin{raggedright}%
    \font[size=9pt, style=italic]{\first-mark}%
  \end{raggedright}%
  \par\vspace[height=2pt]%
  \hrule[width=100%fw, height=0.4pt]%
}

\define[command=odd-running-header]{%
  \begin{raggedleft}%
    \font[size=9pt, style=italic]{\first-mark}%
  \end{raggedleft}%
  \par\vspace[height=2pt]%
  \hrule[width=100%fw, height=0.4pt]%
}

% ==========================================
% 1. PORTADA (Sin numeracion)
% ==========================================
\nofolios
\begin{center}
  \skip[height=6cm]
  \font[size=28pt, weight=700]{Ejemplo 1}
  \par\bigskip
  \font[size=16pt]{Nombre del Autor}
\end{center}
\eject

% ==========================================
% 2. PAGINAS PRELIMINARES (Numeros romanos)
% ==========================================
% Activamos los numeros en romanos minusculos (i, ii, iii...)
% (Si los prefieres en mayusculas I, II, III, usa display=ROMAN)
\set-counter[id=folio, value=1, display=roman]

% Ejemplo de Dedicatoria (opcional, sin aparecer en el indice)
\begin{raggedleft}
  \skip[height=4cm]
  \em{Para quienes disfrutan de la lectura.}
\end{raggedleft}
\eject

% Indice automatico
\tableofcontents
\eject

% Ejemplo de Prologo o Prefacio (aparece en el indice sin numero de capitulo)
\include[src=prologo.sil]

% ==========================================
% 3. CUERPO DEL LIBRO (Numeros arabigos desde 1)
% ==========================================
\set-counter[id=folio, value=1, display=arabic]

\include[src=cap1.sil]
\include[src=cap2.sil]

\end{document}
