\begin[class=book, papersize=a4]{document}

\language[main=es]
\font[family=Liberation Serif, size=12pt]
\set[parameter=document.baselineskip, value=16pt]

% Paquete nativo para lineas finas
\use[module=packages.rules]

% --- ENCABEZADOS ALTERNOS EN .SIL PURO ---
% Paginas pares (izquierda)
\define[command=book:left-running-head]{%
  \begin{raggedright}%
    \font[size=9pt, style=italic]{\first-mark}%
  \end{raggedright}%
  \par\vspace[height=2pt]%
  \hrule[width=100%fw, height=0.4pt]%
}

% Paginas impares (derecha)
\define[command=book:right-running-head]{%
  \begin{raggedleft}%
    \font[size=9pt, style=italic]{\first-mark}%
  \end{raggedleft}%
  \par\vspace[height=2pt]%
  \hrule[width=100%fw, height=0.4pt]%
}

% ==========================================
% 1. PORTADA (Sin numeracion)
% ==========================================
\nofolios
\begin{center}
  \skip[height=6cm]
  \font[size=28pt, weight=700]{Ejemplo 1}
  \par\bigskip
  \font[size=16pt]{Nombre del Autor}
\end{center}
\eject

% ==========================================
% 2. PAGINAS PRELIMINARES (Numeros romanos)
% ==========================================
\folios
\set-counter[id=folio, value=1, display=ROMAN]

% Dedicatoria
\begin{raggedleft}
  \skip[height=4cm]
  \em{Para quienes disfrutan de la lectura.}
\end{raggedleft}
\eject

% Indice automatico
\tableofcontents
\eject

% Prologo (recuerda poner \folios debajo de \chapter dentro de prologo.sil)
\include[src=prologo.sil]

% ==========================================
% 3. CUERPO DEL LIBRO (Numeros arabigos desde 1)
% ==========================================
\open-double-page
\folios
\set-counter[id=folio, value=1, display=arabic]

\include[src=cap1.sil]
\include[src=cap2.sil]

\end{document}
